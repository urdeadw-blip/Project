<?xml version="1.0" encoding="utf-8"?>
<!-- Network security configuration for the Maesylan app.
     We restrict cleartext (HTTP) traffic to only the domains we know
     need it, and require HTTPS for everything else. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext for local development / testing if needed -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
