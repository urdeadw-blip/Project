<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — uses Material 3 / Material Components. -->
    <style name="Theme.Maesylan" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand colours -->
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorPrimaryDark">@color/cyan_dark</item>
        <item name="colorPrimaryVariant">@color/cyan_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <item name="colorSecondary">@color/sky</item>
        <item name="colorOnSecondary">@color/red_900</item>

        <item name="android:colorBackground">@color/cream</item>
        <item name="colorSurface">@color/cream</item>
        <item name="colorOnSurface">@color/ink</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/red_950</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Smooth window transitions -->
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <!-- Splash screen theme — used by the launcher activity.
         On Android 12+ the SplashScreen API uses these windowSplashScreen*
         attributes. On older devices we fall back to a simple branded window
         background. -->
    <style name="Theme.Maesylan.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/red_950</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Maesylan</item>

        <!-- Fallback for older devices: just use the dark background. -->
        <item name="android:windowBackground">@color/red_950</item>
    </style>

</resources>
